---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Hamburger Rapid: Alta cocina en comida rápida. Catálogo de hamburguesas a la parrilla con ingredientes 100% Angus y entrega express en 25 minutos." />
  
  <!-- Tipografía Premium Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #fcfbfa;
      --surface: #ffffff;
      --surface-subtle: #f8fafc;
      --border: #e2e8f0;
      --border-warm: #f1ede7;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --text-light: #94a3b8;
      --primary: #d97706; /* Ambar dorado premium */
      --primary-hover: #b45309;
      --primary-light: #fef3c7;
      --accent-flame: #ea580c;
      --accent-ruby: #dc2626;
      --success: #059669;
      --shadow-sm: 0 2px 4px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.03);
      --shadow-lg: 0 20px 35px -10px rgba(15, 23, 42, 0.1), 0 10px 15px -5px rgba(15, 23, 42, 0.04);
      --shadow-glow: 0 15px 30px rgba(217, 119, 6, 0.15);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Announcement Bar */
    .top-announcement {
      background: linear-gradient(90deg, #1e293b, #0f172a);
      color: #f8fafc;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 8px 16px;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      letter-spacing: 0.02em;
    }

    .top-announcement span.sparkle {
      color: #fbbf24;
    }

    .top-announcement a {
      color: #fbbf24;
      text-decoration: underline;
      font-weight: 700;
      margin-left: 4px;
    }

    /* Header & Navigation */
    header.main-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-warm);
      box-shadow: var(--shadow-sm);
      transition: all 0.3s ease;
    }

    .nav-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
    }

    .brand-name {
      font-weight: 800;
      font-size: 1.35rem;
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: #0f172a;
    }

    .brand-sub {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--primary);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: #475569;
      font-weight: 600;
      font-size: 0.92rem;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn-admin {
      background: #f1f5f9;
      color: #334155;
      padding: 9px 16px;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      border: 1px solid #e2e8f0;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-admin:hover {
      background: #e2e8f0;
      color: #0f172a;
    }

    .btn-pwa {
      background: linear-gradient(135deg, #ea580c, #d97706);
      color: white;
      padding: 10px 20px;
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(234, 88, 12, 0.3);
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-pwa:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(234, 88, 12, 0.4);
    }

    /* Hero Section */
    .hero-section {
      padding: 60px 24px 80px;
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 50px;
    }

    .hero-content {
      text-align: left;
    }

    .hero-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      color: #92400e;
      padding: 6px 16px;
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      margin-bottom: 20px;
      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.08);
    }

    .hero-title {
      font-size: 3.4rem;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: #0f172a;
      margin-bottom: 20px;
    }

    .hero-title span.highlight {
      background: linear-gradient(135deg, #d97706 0%, #ea580c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      font-size: 1.15rem;
      color: #475569;
      line-height: 1.65;
      margin-bottom: 32px;
      max-width: 580px;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }

    .btn-hero-primary {
      background: linear-gradient(135deg, #d97706, #b45309);
      color: white;
      text-decoration: none;
      padding: 15px 30px;
      border-radius: var(--radius-md);
      font-weight: 800;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 10px 24px rgba(217, 119, 6, 0.35);
      transition: all 0.25s ease;
    }

    .btn-hero-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 28px rgba(217, 119, 6, 0.45);
    }

    .btn-hero-secondary {
      background: #ffffff;
      color: #0f172a;
      text-decoration: none;
      padding: 15px 26px;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.98rem;
      border: 1px solid #cbd5e1;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .btn-hero-secondary:hover {
      background: #f8fafc;
      border-color: #94a3b8;
      transform: translateY(-2px);
    }

    .hero-stats-row {
      display: flex;
      align-items: center;
      gap: 32px;
      border-top: 1px solid var(--border-warm);
      padding-top: 24px;
    }

    .hero-stat-item h4 {
      font-size: 1.6rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.1;
    }

    .hero-stat-item p {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      margin-top: 2px;
    }

    /* Hero Visual Card */
    .hero-visual {
      position: relative;
    }

    .hero-visual-card {
      background: #ffffff;
      border-radius: 28px;
      padding: 18px;
      box-shadow: var(--shadow-lg);
      border: 1px solid rgba(226, 232, 240, 0.8);
      position: relative;
      overflow: hidden;
    }

    .hero-image-wrap {
      border-radius: 20px;
      overflow: hidden;
      height: 380px;
      position: relative;
    }

    .hero-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }

    .hero-visual-card:hover .hero-image-wrap img {
      transform: scale(1.04);
    }

    .floating-card-top {
      position: absolute;
      top: 30px;
      left: -20px;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(8px);
      padding: 12px 18px;
      border-radius: 16px;
      box-shadow: var(--shadow-md);
      border: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      gap: 12px;
      animation: floatSlow 4s ease-in-out infinite alternate;
    }

    .floating-card-bottom {
      position: absolute;
      bottom: 25px;
      right: -15px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      padding: 14px 20px;
      border-radius: 16px;
      box-shadow: var(--shadow-md);
      border: 1px solid #fde68a;
      display: flex;
      align-items: center;
      gap: 12px;
      animation: floatSlow 4s ease-in-out infinite alternate-reverse;
    }

    @keyframes floatSlow {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-10px); }
    }

    /* Features 4 Pillars Section */
    .features-strip {
      background: #ffffff;
      border-top: 1px solid var(--border-warm);
      border-bottom: 1px solid var(--border-warm);
      padding: 40px 24px;
    }

    .features-grid {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
