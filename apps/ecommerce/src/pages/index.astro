  </section>

  <!-- Catalog Section -->
  <section class="catalog-section" id="catalogo">
    <div class="section-header">
      <span class="section-tag">Colección Destacada</span>
      <h2 class="section-title">Nuestras 10 Obras Maestras</h2>
      <p class="section-subtitle">
        Desde nuestras insignias a la brasa hasta creaciones smash y alternativas gourmet. Selecciona tu hamburguesa favorita y descubre todos sus detalles.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="filter-tabs">
      <button class="filter-btn active" data-filter="all">Todas (10)</button>
      <button class="filter-btn" data-filter="especiales">Especialidades del Chef</button>
      <button class="filter-btn" data-filter="clasicas">Clásicas Gourmet</button>
      <button class="filter-btn" data-filter="parrilla">Doble Parrilla & Smash</button>
      <button class="filter-btn" data-filter="pollo">Pollo Crispy</button>
      <button class="filter-btn" data-filter="veggie">Plant-Based</button>
    </div>

    <!-- The 10 Burgers Grid -->
    <div class="burgers-grid">
      {burgers.map((burger) => (
        <article class="burger-card" data-category={burger.category} id={burger.id}>
          <div class="card-media">
            <img src={burger.image} alt={burger.name} loading="lazy" />
            <div class="specialty-badge-float">
              {burger.specialtyBadge}
            </div>
            <div class="card-badge-rating">
              <span class="star">★</span> {burger.rating} ({burger.reviews})
            </div>
          </div>

          <div class="card-body">
            <div class="card-meta-row">
              <span class="card-category-name">{burger.categoryLabel}</span>
              <span class="card-level-badge">{burger.specialtyLevel}</span>
            </div>

            <h3 class="burger-title">{burger.name}</h3>
            <p class="burger-desc">{burger.shortDesc}</p>

            <div class="ingredients-pill-row">
              {burger.tags.map((tag) => (
                <span class="ingredient-tag">{tag}</span>
              ))}
            </div>

            <div class="card-footer">
              <div class="price-wrap">
                <span class="price-label">Precio</span>
                <div class="price-amount">${burger.price.toFixed(2)} <small>USD</small></div>
              </div>

              <button
                class="btn-details"
                data-burger={JSON.stringify(burger)}
                onclick="openBurgerModal(this)"
              >
                <span>🔍</span> Ver Detalles
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Delivery CTA Banner -->
  <section class="delivery-cta-section">
