    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .feature-icon-box {
      width: 48px;
      height: 48px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 12px;
